# -----------------------------------------------------------------------------
# Python bytecode / caches
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class

# -----------------------------------------------------------------------------
# Virtual environments / local Python envs
# -----------------------------------------------------------------------------
# No trailing slash: .venv may be a link to an environment outside a synced folder.
.venv
venv/
env/
ENV/

# -----------------------------------------------------------------------------
# Test / type-check / lint / tooling artifacts
# -----------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.uv-cache/
.dependency-cache/
.coverage
.coverage*
htmlcov/

# -----------------------------------------------------------------------------
# Secrets / local env files
# -----------------------------------------------------------------------------
.env
.env.*
*.pem
*.key
*.secrets

# -----------------------------------------------------------------------------
# Source copies and build outputs
# -----------------------------------------------------------------------------
# PDFs are build outputs or local copies; only the compiled compendium and model reference are kept.
*.pdf
!compendium/compendium.pdf
!model-derivations/model-reference.pdf
# The learning guide is a vendored copy; its compiled PDFs and catalogue .aux are kept.
!guide/*.pdf
!guide/institutional_quantitative_finance_reading_list.aux

# Local copies of sources, never committed.
reading materials/
reading_materials/

# Local research runs: each subsection's runs/ folder below src/data; its retained files are tracked.
/src/data/*/runs/

# -----------------------------------------------------------------------------
# LaTeX intermediate files
# -----------------------------------------------------------------------------
*.aux
*.bbl
*.blg
*.brf
*.fls
*.fdb_latexmk
*.log
*.out
*.toc
*.lof
*.lot
*.synctex.gz
*.nav
*.snm
*.vrb
*.xdv
*.dvi
*.ps
*.ilg
*.ind
*.idx
*.glg
*.glo
*.gls
*.acn
*.acr
*.alg
*.ist
*.xdy
*.bcf
*.run.xml
*.thm
*.tdo

# -----------------------------------------------------------------------------
# IDE / editor
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo

# -----------------------------------------------------------------------------
# OS files
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
