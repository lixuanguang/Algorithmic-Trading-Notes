from typing import Literal, overload

import numpy as np
from numpy.typing import NDArray
from statsmodels.regression._prediction import PredictionResults
from statsmodels.stats.contrast import ContrastResults
from statsmodels.stats.outliers_influence import OLSInfluence

class OLS:
    def __init__(self, endog: NDArray[np.float64], exog: NDArray[np.float64]) -> None: ...
    @overload
    def fit(self) -> RegressionResults: ...
    @overload
    def fit(self, cov_type: Literal["HAC"], cov_kwds: dict[str, int]) -> RegressionResults: ...

# Fitted on arrays, every array result is an ndarray (on frames they would be pandas objects).
class RegressionResults:
    @property
    def params(self) -> NDArray[np.float64]: ...
    @property
    def bse(self) -> NDArray[np.float64]: ...
    @property
    def tvalues(self) -> NDArray[np.float64]: ...
    @property
    def pvalues(self) -> NDArray[np.float64]: ...
    @property
    def resid(self) -> NDArray[np.float64]: ...
    @property
    def fvalue(self) -> np.float64: ...
    @property
    def rsquared(self) -> np.float64: ...
    @property
    def mse_resid(self) -> np.float64: ...
    @property
    def rsquared_adj(self) -> np.float64: ...
    @property
    def f_pvalue(self) -> np.float64: ...
    @property
    def ssr(self) -> np.float64: ...
    @property
    def aic(self) -> np.float64: ...
    @property
    def bic(self) -> np.float64: ...
    @property
    def fittedvalues(self) -> NDArray[np.float64]: ...
    # (F statistic, p-value, difference in degrees of freedom) against a nested restricted model.
    def compare_f_test(
        self, restricted: RegressionResults
    ) -> tuple[np.float64, np.float64, np.float64]: ...
    @overload
    def get_robustcov_results(self, cov_type: Literal["HC1"]) -> RegressionResults: ...
    @overload
    def get_robustcov_results(
        self, cov_type: Literal["HAC"], maxlags: int
    ) -> RegressionResults: ...
    def conf_int(self, alpha: float = 0.05) -> NDArray[np.float64]: ...
    def f_test(
        self, r_matrix: tuple[NDArray[np.float64], NDArray[np.float64]]
    ) -> ContrastResults: ...
    def get_influence(self) -> OLSInfluence: ...
    def get_prediction(self, exog: NDArray[np.float64]) -> PredictionResults: ...
